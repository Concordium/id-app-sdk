  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@concordium/web-sdk": "^9.1.0",
    "vite-plugin-dts": "^4.5.4"
  }
