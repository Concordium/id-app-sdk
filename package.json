{
  "name": "id-app-sdk",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/idapp-sdk.js",
  "module": "./dist/idapp-sdk.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
